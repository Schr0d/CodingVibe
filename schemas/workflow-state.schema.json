{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coding-vibe.local/schemas/workflow-state.schema.json",
  "title": "Workflow State",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "producer", "generated_at", "ttl_ms", "workflow", "safety"],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "producer": {
      "type": "string",
      "minLength": 1
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "ttl_ms": {
      "type": "integer",
      "minimum": 1
    },
    "workflow": {
      "type": "object",
      "additionalProperties": true,
      "required": ["mode", "confidence", "signals"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["unknown", "deep_work", "planning", "debugging", "reviewing", "writing", "waiting_ci", "idle"]
        },
        "phase": {
          "type": "string"
        },
        "momentum": {
          "type": "string",
          "enum": ["moving", "blocked", "waiting", "unknown"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "signals": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 160
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": true,
      "required": ["redactions_applied", "forbidden_fields_seen"],
      "properties": {
        "redactions_applied": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "forbidden_fields_seen": {
          "type": "boolean"
        }
      }
    }
  }
}
