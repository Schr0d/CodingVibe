{
  "name": "coding-vibe",
  "version": "0.0.0",
  "description": "Local inspectable workflow-state sidecar for coding agents.",
  "type": "module",
  "bin": {
    "vibe": "./dist/cli.js",
    "coding-vibe": "./dist/cli.js"
  },
  "files": [
    "dist",
    "schemas",
    "examples",
    "README.md",
    "LICENSE",
    "LICENSE.schemas"
